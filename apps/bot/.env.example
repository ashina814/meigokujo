# Discord Bot Token（Developer Portal → Bot）
DISCORD_TOKEN=
# Application (Client) ID
CLIENT_ID=
# /管理 を必ず開ける管理者（あなた）の Discord User ID
OWNER_ID=
# SQLite の保存先（省略時 ./data/bot.db）
DB_PATH=./data/bot.db
# Optional: formal-opening apply（未設定ならapplyをfail-closedで無効化）
CASINO_OPENING_BACKUP_DIR=./data/casino-opening-backups
# Optional: internal economy API（TOKEN未設定ならAPIを起動しない）
ECONOMY_API_TOKEN=
# カンマ区切りで複数hostを指定可能
ECONOMY_API_HOST=172.17.0.1
ECONOMY_API_PORT=8787
# 開発用: テストサーバーのID（設定するとコマンド登録が即時反映になる）
GUILD_ID=
# GUILD_IDが設定されていても、1ならglobal登録を強制する
REGISTER_GLOBAL=0
