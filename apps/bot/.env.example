# Discord Bot Token（Developer Portal → Bot）
DISCORD_TOKEN=
# Application (Client) ID
CLIENT_ID=
# /設定 を必ず開ける管理者（あなた）の Discord User ID
OWNER_ID=
# SQLite の保存先（省略時 ./data/bot.db）
DB_PATH=./data/bot.db
# Formal opening persistent backup directory. Required only when executing opening reset apply.
CASINO_OPENING_BACKUP_DIR=./data/casino-opening-backups
# 開発用: テストサーバーのID（設定するとコマンド登録が即時反映になる）
GUILD_ID=
